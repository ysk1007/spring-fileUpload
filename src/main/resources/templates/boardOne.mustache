<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>파일 상세</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8fafc;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .detail-container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 2.5rem;
      border-radius: 1rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    }
    .section-title {
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #333;
    }
    .btn-edit {
      background-color: #6366f1;
      border-color: #6366f1;
      color: white;
    }
    .btn-edit:hover {
      background-color: #4f46e5;
      border-color: #4f46e5;
    }
    .btn-delete {
      background-color: #ef4444;
      border-color: #ef4444;
      color: white;
    }
    .btn-delete:hover {
      background-color: #dc2626;
      border-color: #dc2626;
    }
    .file-link {
      text-decoration: none;
      color: #0d6efd;
      margin-right: 0.5rem;
    }
    .file-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <div class="container py-5">
    <div class="detail-container">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="section-title">📁 파일 상세</h1>
        <a href="/" class="btn btn-outline-secondary">← 리스트</a>
      </div>

      <div class="mb-4">
        <p><strong>#{{boardMapping.bno}}</strong></p>
        <p>제목 : {{boardMapping.title}}</p>
      </div>

      <div class="d-flex gap-2 mb-4">
        <a href="modifyBoard?bno={{boardMapping.bno}}" class="btn btn-edit">수정</a>
        <a href="removeBoard?bno={{boardMapping.bno}}" class="btn btn-delete">삭제</a>
      </div>

      <hr>

      <div>
        <h2 class="section-title">📎 첨부파일</h2>
        {{#fileList}}
          <div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2">
            <a href="/upload/{{fname}}.{{fext}}" download="{{foriginname}}" class="file-link">{{foriginname}}</a>
            <a href="/removeBoardfile?fno={{fno}}&bno={{boardMapping.bno}}" class="btn btn-sm btn-outline-danger">삭제</a>
          </div>
        {{/fileList}}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
